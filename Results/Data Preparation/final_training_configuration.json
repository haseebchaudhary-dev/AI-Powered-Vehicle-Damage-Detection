{
    "project": "AI Insurance Claim Automation",
    "dataset": "CARDD",
    "dataset_yaml": "Results\\DATA PREPARATION\\dataset.yaml",
    "model": "yolo11m.pt",
    "architecture": "YOLO11m",
    "task": "object_detection",
    "initialization": "pretrained_weights",
    "image_size": 832,
    "epochs": 150,
    "patience": 20,
    "batch": "auto",
    "device": 0,
    "workers": 2,
    "amp": true,
    "seed": 42,
    "deterministic": true,
    "optimizer": "AdamW",
    "lr0": 0.0005,
    "lrf": 0.05,
    "weight_decay": 0.0005,
    "warmup_epochs": 2.0,
    "cos_lr": true,
    "classes": [
        "dent",
        "scratch",
        "crack",
        "glass shatter",
        "lamp broken",
        "tire flat"
    ],
    "number_of_classes": 6,
    "augmentation_strategy": {
        "hsv_h": 0.01,
        "hsv_s": 0.4,
        "hsv_v": 0.25,
        "degrees": 2.0,
        "translate": 0.08,
        "scale": 0.3,
        "shear": 0.0,
        "perspective": 0.0,
        "fliplr": 0.5,
        "flipud": 0.0,
        "mosaic": 0.5,
        "mixup": 0.0,
        "copy_paste": 0.0,
        "close_mosaic": 10
    },
    "validation_split": "val",
    "run_name": "yolo11m_832_adamw_final"
}